script/source = "extends Area2D
## TEMPORARY. A thing that hurts you, so i can prove i-frames work.
## Do not delete at the end of this lesson — disable it. It becomes the
## i-frame visualiser later.

func _ready() -> void:
	body_entered.connect(_on_body_entered)


func _on_body_entered(body) -> void:
	if body is PlayerController and body.invulnerable:
		return
	print(\"HIT\")
"

