[sub_resource type="GDScript" id="GDScript_ceyr3"]
script/source = "extends CharacterBody2D

@onready var health: HealthComponent = $Health
const KNOCKBACK_DECAY := 1700.0
const KNOCKBACK_TAKEN := 0.6      # the player is shoved less than enemies are

var _knockback := Vector2.ZERO
func _ready() -> void:
	health.died.connect(_on_health_died)
func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"quick_attack\"):
		health.damage(10.0)
		print(health.current_health)

func _physics_process(delta: float) -> void:
	velocity = _knockback
	_knockback = _knockback.move_toward(Vector2.ZERO, KNOCKBACK_DECAY * delta)
	move_and_slide()
func _on_health_died() -> void:
	queue_free()
func apply_knockback(dir: Vector2, force: float) -> void:
	_knockback = dir.normalized() * force * KNOCKBACK_TAKEN
	
"

